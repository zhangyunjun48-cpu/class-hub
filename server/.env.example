NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://classhub_dev:change-me@db-host:5432/classhub_dev
APP_ORIGIN=http://127.0.0.1:5173
# 允许的写请求来源，逗号分隔。留空时只允许 APP_ORIGIN。
ALLOWED_ORIGINS=
LOG_LEVEL=info
DEPLOY_VERSION=local
BUILD_TIME=

# --- 正式版身份与安全（生产环境必填）---
# 至少 32 字符随机值，用于签发激活挑战与 IP 哈希。
AUTH_SECRET=
# 至少 32 字符随机值，用于学号 HMAC。泄露后必须重新导入名单。
STUDENT_ID_HMAC_KEY=
# 班级共用激活码，至少 8 字符，只发给本班同学。
CLASS_ACTIVATION_CODE=
# 系统兜底 Owner：服务器恢复密钥初始化，不可删除或降级。
FALLBACK_OWNER_ID=
FALLBACK_OWNER_NAME=
FALLBACK_OWNER_KEY=

# 生产 HTTPS 环境必须设为 true；仅本地 http 调试时保持 false。
COOKIE_SECURE=false
SESSION_DAYS=30
ADMIN_REAUTH_MINUTES=15