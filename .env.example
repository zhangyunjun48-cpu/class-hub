# ===== 运行模式 =====
# remote（默认）：连接后端 API（/api），正式部署用这个
# mock：离线演示数据（localStorage + BroadcastChannel），不需要后端，用来试玩界面
VITE_DATA_MODE=mock

# 仅本地开发：Vite 把浏览器 /api 请求代理到该地址（留空则不连远程）
VITE_API_TARGET=

# ===== 站点身份（都是可选的，留空使用中性默认值）=====
# 站点名（浏览器标题与页头）—— 例如 11 班共享站
VITE_SITE_NAME=
# 页头圆形徽标里的字（1-2 个字）—— 例如 11
VITE_BRAND_MARK=
# 学校名（页头副标题；留空则不显示）
VITE_SCHOOL_NAME=
# 班级名 —— 例如 智能软件与芯片新工科实验班 11 班
VITE_CLASS_NAME=
# 登录页与首页的一句话说明
VITE_SITE_TAGLINE=

# ===== 备案信息（仅正式部署需要；留空则页脚不显示）=====
VITE_ICP_LICENSE=
VITE_PUBLIC_SECURITY_LICENSE=
VITE_PUBLIC_SECURITY_CODE=

# ===== 本地存储键名（默认已中性，一般不用改）=====
VITE_THEME_STORAGE_KEY=
# 旧版本留下的缓存前缀，用逗号分隔，Service Worker 清理时会一并删除
VITE_LEGACY_CACHE_PREFIXES=