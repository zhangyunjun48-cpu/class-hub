# 单机正式版环境文件（服务器上的 /opt/class-hub/.env，权限 600）
# 首次可以直接让 deploy/scripts/deploy-prod-single.sh 自动生成，无需手抄。

APP_DOMAIN=<your-domain>
ACME_EMAIL=your-mail@example.com
WEB_ROOT=/opt/class-hub/web
LOG_LEVEL=info
DEPLOY_VERSION=unknown
BUILD_TIME=

POSTGRES_USER=classhub
POSTGRES_PASSWORD=change-me-use-openssl-rand-hex-24
POSTGRES_DB=classhub_prod
DATABASE_URL=postgresql://classhub:change-me-use-openssl-rand-hex-24@postgres:5432/classhub_prod

# 正式版身份与安全（必填，缺失时 docker compose 直接拒绝启动）
AUTH_SECRET=
STUDENT_ID_HMAC_KEY=
CLASS_ACTIVATION_CODE=

# 系统兜底 Owner：用来完成第一次登录、设管理员 PIN、导入名单。导入真实名单后可保留。
FALLBACK_OWNER_ID=
FALLBACK_OWNER_NAME=
FALLBACK_OWNER_KEY=

SESSION_DAYS=30
ADMIN_REAUTH_MINUTES=15