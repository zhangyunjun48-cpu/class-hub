APP_DOMAIN=class11.example.cn
STAGING_DOMAIN=staging.class11.example.cn
ACME_EMAIL=admin@example.cn
WEB_ROOT=/opt/class-hub/web
DEPLOY_VERSION=unknown
BUILD_TIME=
LOG_LEVEL=info

PROD_DATABASE_URL=postgresql://classhub_prod:change-me@postgres.internal:5432/classhub_prod
STAGING_DATABASE_URL=postgresql://classhub_staging:change-me@postgres.internal:5432/classhub_staging

# --- 正式版身份与安全（生产/Staging 必填，缺失时 compose 会拒绝启动）---
# 使用 `openssl rand -base64 48` 生成，两者必须不同。
AUTH_SECRET=
STUDENT_ID_HMAC_KEY=
# 班级共用激活码，至少 8 字符，只发给本班同学。
CLASS_ACTIVATION_CODE=
# 额外允许的写请求来源（一般留空，APP_DOMAIN 已自动允许）。
ALLOWED_ORIGINS=
# 系统兜底 Owner，仅在 HTTPS 环境使用虚构值初始化。
FALLBACK_OWNER_ID=
FALLBACK_OWNER_NAME=
FALLBACK_OWNER_KEY=
SESSION_DAYS=30
ADMIN_REAUTH_MINUTES=15